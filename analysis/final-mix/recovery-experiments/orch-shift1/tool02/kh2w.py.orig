"""Read-only worker helper for KH2FM recovery.

  python -I kh2w.py packet ADDRESS OUTDIR   write OUTDIR/ADDRESS-packet.md (everything a worker needs)
  python -I kh2w.py diff PROOF.verification.json [OUTFILE]
                                            side-by-side original vs compiled disassembly of a probe
  python -I kh2w.py probe SOURCE.cpp        run the project's isolated probe through the shared probe slots
                                            (at most 3 at once across all agents); refuses a version name
                                            whose .verification.json already exists

It never writes to the queue, registries, stage, or any existing file. It runs on the Windows host and
calls WSL only to run the pinned objdump against the stage (mounted read-only).
"""
import json
import re
import sqlite3
import subprocess
import sys
from pathlib import Path

AGENTS = Path('C:/Users/KoZa/Documents/AGENTS')
CODEX = AGENTS / 'Codex'
AREA = CODEX / 'analysis/final-mix'
REFERENCE = AGENTS / 'Public/tools/kh2-reference'
QUEUE_DB = AREA / 'worker-coordination/recovery-queue.sqlite3'
IMAGE = 'kh2-local/ps2-compiler:3.2-ee-040921-objdiff'
STAGE = '/root/kh2fm-build'


def objdump(path_in_stage, start, size):
    command = ['wsl', '-d', 'Ubuntu-24.04', '-u', 'root', '--', 'docker', 'run', '--rm', '--platform', 'linux/amd64',
               '-v', f'{STAGE}:/work:ro', '-w', '/work', IMAGE, '/opt/ps2/gcc/bin/ee-objdump', '-d',
               f'--start-address=0x{start:x}', f'--stop-address=0x{start + size:x}', path_in_stage]
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0:
        raise SystemExit('objdump failed (is Docker Desktop running?):\n' + result.stderr)
    rows = []
    for line in result.stdout.splitlines():
        match = re.match(r'\s*([0-9a-f]+):\s+([0-9a-f]{8})\s+(.*)$', line)
        if match:
            rows.append((int(match.group(1), 16), match.group(2), match.group(3).strip()))
    return rows


STORES = {'sb', 'sh', 'sw', 'sd', 'sq', 'swc1', 'sdc1', 'swl', 'swr', 'sdl', 'sdr'}


def annotate(rows):
    """Resolve lui/low-half pairs. objdump prints the low half already sign-extended (decimal)."""
    high = {}
    out = []
    for address, word, text in rows:
        note = ''
        lui = re.match(r'lui\s+(\w+),0x([0-9a-f]+)$', text)
        if lui:
            high[lui.group(1)] = int(lui.group(2), 16) << 16
        else:
            memory = re.search(r',(-?\d+)\((\w+)\)$', text)
            add = re.match(r'addiu\s+\w+,(\w+),(-?\d+)$', text)
            base, low = (memory.group(2), int(memory.group(1))) if memory else ((add.group(1), int(add.group(2))) if add else (None, None))
            if base in high:
                note = f'   ; = D_{(high[base] + low) & 0xffffffff:08x}'
            first = re.match(r'([a-z0-9.]+)\s+(\w+)', text)
            if first and first.group(1) not in STORES and not first.group(1).startswith(('b', 'j')):
                high.pop(first.group(2), None)
        out.append(f'{address:08x}: {word}  {text}{note}')
    return out


def layout_row(address):
    for line in (REFERENCE / 'layout.tsv').read_text().splitlines():
        parts = line.split('\t')
        if parts and parts[0] == address:
            return {'addr': parts[0], 'end': parts[1], 'size': int(parts[2]), 'name': parts[3]}
    return None


def registry():
    names = {}
    for line in (REFERENCE / 'functions.tsv').read_text().splitlines():
        if line and not line.startswith('#') and '\t' in line:
            name, address = line.split('\t')[:2]
            names.setdefault(address.lower(), []).append(name)
    return names


def assembly_defined():
    """func_ symbols defined in legacy .s files at temporary (non-native) placement; see review_wp.py."""
    found = set()
    for path in (REFERENCE / 'src').rglob('*.s'):
        text = path.read_text(errors='replace')
        for symbol in re.findall(r'\.globl\s+func_([0-9a-f]{8})', text):
            if f'.text.func_{symbol}' not in text:
                found.add(symbol)
    return found


def queue_row(address):
    db = sqlite3.connect(f'file:{QUEUE_DB.as_posix()}?mode=ro', uri=True)
    try:
        row = db.execute('SELECT state,queue,owner,attempts,metadata,blocker,artifacts FROM targets WHERE address=?', (address,)).fetchone()
    finally:
        db.close()
    if not row:
        return None
    keys = ['state', 'queue', 'owner', 'attempts', 'metadata', 'blocker', 'artifacts']
    return dict(zip(keys, row))


def pseudocode(address):
    with (AREA / 'native-pseudocode/main.jsonl').open(encoding='utf-8') as stream:
        pattern = re.compile(r'"address":\s*"' + address + '"')
        for line in stream:
            if pattern.search(line):
                return json.loads(line)
    return None


def prior_attempts(address):
    proofs = []
    for path in (AREA / 'recovery-experiments').rglob(f'*{address}*.verification.json'):
        try:
            rows = [r for r in json.loads(path.read_text())['rows'] if r['address'] == address]
        except (ValueError, KeyError):
            continue
        if rows:
            r = rows[0]
            original, compiled = bytes.fromhex(r['target_hex']), bytes.fromhex(r['compiled_hex'])
            differing = sum(original[i:i + 4] != compiled[i:i + 4] for i in range(0, max(len(original), len(compiled)), 4))
            proofs.append((path, r['exact_match'], r['compiled_size'], r['target_size'], differing))
    reports = [p for p in (AREA / 'recovery-experiments').rglob(f'*{address}*.md')]
    return proofs, reports


def packet(address, outdir):
    assert re.fullmatch('[0-9a-f]{8}', address), 'ADDRESS must be 8 lowercase hex digits'
    outdir = Path(outdir).resolve()
    outdir.mkdir(parents=True, exist_ok=True)
    target = outdir / f'{address}-packet.md'
    assert not target.exists(), f'Refuse overwrite: {target}'
    lay = layout_row(address)
    q = queue_row(address)
    size = lay['size'] if lay else (json.loads(q['metadata'])['bytes'] if q else None)
    assert size, 'Address is neither in layout.tsv nor in the queue'
    names = registry()
    in_asm = assembly_defined()
    code = pseudocode(address)
    lines = [f'# Target packet {address}', '',
             f'- Range: `{address}`..`{int(address, 16) + size:08x}`, **{size} bytes = {size // 4} instructions**. This size is the acceptance size.',
             f'- Layout name: `{lay["name"] if lay else "(not in layout.tsv)"}`',
             f'- Registry names for this address: {", ".join("`" + n + "`" for n in names.get(address, [])) or "none"}']
    if q:
        meta = json.loads(q['metadata'])
        lines.append(f'- Queue: state `{q["state"]}`, queue `{q["queue"]}`, attempts {q["attempts"]}, priority {meta.get("priority")}')
        if q['blocker']:
            lines.append(f'- Earlier blocker: `{q["blocker"]}`')
    lines += ['', '## Callees', '']
    callees = []
    if code and code.get('callees'):
        callees = re.findall('[0-9a-f]{8}', str(code['callees']))
    rows = objdump('SLPM_666.75', int(address, 16), size)
    for _, _, text in rows:
        jump = re.match(r'(?:jal|j)\s+0x([0-9a-f]+)$', text)
        if jump:
            callees.append(f'{int(jump.group(1), 16):08x}')
    seen = []
    accepted_sources = {path: path.read_text(errors='replace') for path in (REFERENCE / 'src/anon').glob('fm_*.cpp')}
    for callee in callees:
        if callee in seen or callee == address:
            continue
        seen.append(callee)
        flag = ' **DEFINED IN LEGACY ASSEMBLY: call it through `D_' + callee + '`, never `func_' + callee + '`**' if callee in in_asm else ''
        alias = ', '.join('`' + n + '`' for n in names.get(callee, [])) or 'none'
        lines.append(f'- `{callee}` registry: {alias}{flag}')
        siblings = sorted(p.name for p, text in accepted_sources.items() if f'_{callee}' in text)[:5]
        if siblings:
            lines.append(f'  - accepted sources that already call it (copy their declaration): {", ".join("`" + s + "`" for s in siblings)}')
    if not seen:
        lines.append('- none')
    lines += ['', '## Original instructions (absolute addresses decoded; low halves are signed)', '', '```']
    lines += annotate(rows)
    lines += ['```', '', '## Ghidra pseudocode (advisory only: signatures, widths and returns are often wrong)', '']
    if code:
        lines += [f'Signature: `{code.get("signature")}`', '', '```c', str(code.get('code', '')).replace('\r', '').strip(), '```']
    else:
        lines.append('No main.jsonl record.')
    proofs, reports = prior_attempts(address)
    lines += ['', '## Earlier attempts (newest first)', '']
    for path, exact, compiled, wanted, differing in sorted(proofs, key=lambda p: p[0].stat().st_mtime, reverse=True)[:15]:
        lines.append(f'- {"EXACT" if exact else f"{differing} differing words, {compiled}/{wanted} bytes"}: `{path.relative_to(CODEX).as_posix()}`')
    for path in reports[:10]:
        lines.append(f'- report: `{path.relative_to(CODEX).as_posix()}`')
    if not proofs and not reports:
        lines.append('- none found')
    target.write_text('\n'.join(lines) + '\n', encoding='utf-8')
    print(target)


def diff(proof_path, outfile=None):
    proof_path = Path(proof_path).resolve()
    data = json.loads(proof_path.read_text())
    assert len(data['rows']) == 1, 'One function per source file is the project rule'
    row = data['rows'][0]
    address = int(row['address'], 16)
    stem = proof_path.name[:-len('.verification.json')]
    original = objdump('SLPM_666.75', address, row['target_size'])
    compiled = objdump(f'recovery-experiments/{stem}/probe.elf', address, row['compiled_size'])
    left, right = annotate(original), annotate(compiled)
    out = [f'{row["address"]}: compiled {row["compiled_size"]} bytes, target {row["target_size"]} bytes, exact={row["exact_match"]}', '',
           f'{"ORIGINAL":<72}| COMPILED']
    differing = 0
    first = None
    for index in range(max(len(left), len(right))):
        a = left[index] if index < len(left) else ''
        b = right[index] if index < len(right) else ''
        same = index < len(original) and index < len(compiled) and original[index][1] == compiled[index][1]
        if not same:
            differing += 1
            first = index if first is None else first
        out.append(f'{"  " if same else "!!"} {a:<69}| {b}')
    out.insert(1, f'Differing words: {differing}. First difference at instruction {first} (0-based).')
    text = '\n'.join(out) + '\n'
    if outfile:
        target = Path(outfile)
        assert not target.exists(), f'Refuse overwrite: {target}'
        target.write_text(text, encoding='utf-8')
    print(text)


LOCKS = CODEX / 'orchestration/locks'
PROBE_SLOTS = 3
SLOT_STALE_SECONDS = 600


def acquire_slot():
    """At most PROBE_SLOTS probes run at once across all agents (each probe is a Docker container in WSL)."""
    import os
    import time
    LOCKS.mkdir(parents=True, exist_ok=True)
    deadline = time.time() + 900
    while time.time() < deadline:
        for number in range(PROBE_SLOTS):
            slot = LOCKS / f'probe-slot-{number}.lock'
            try:
                descriptor = os.open(slot, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            except FileExistsError:
                try:
                    if time.time() - slot.stat().st_mtime > SLOT_STALE_SECONDS:
                        slot.unlink()  # a crashed agent left it behind
                except OSError:
                    pass
                continue
            os.write(descriptor, f'pid {os.getpid()}\n'.encode())
            os.close(descriptor)
            return slot
        time.sleep(3)
    raise SystemExit('No probe slot free after 15 minutes; try again later (other agents are probing).')


def probe(source):
    """Probe one source through the shared slots. Refuses to reuse a version name (evidence is never overwritten)."""
    source = Path(source).resolve()
    assert source.suffix == '.cpp' and source.is_relative_to(CODEX), 'Source must be a .cpp inside Codex'
    if source.with_suffix('.verification.json').exists():
        raise SystemExit(f'Refused: {source.with_suffix(".verification.json").name} already exists. Use a new version name (_v<N+1>).')
    wsl_path = '/mnt/c/' + source.as_posix()[3:]
    slot = acquire_slot()
    try:
        result = subprocess.run(['wsl', '-d', 'Ubuntu-24.04', '-u', 'root', '--', 'python3',
                                 '/mnt/c/Users/KoZa/Documents/AGENTS/Public/tools/kh2-audit/probe_fm_source.py', wsl_path, '--summary'])
    finally:
        slot.unlink(missing_ok=True)
    sys.exit(result.returncode)


if __name__ == '__main__':
    if len(sys.argv) == 3 and sys.argv[1] == 'probe':
        probe(sys.argv[2])
    elif len(sys.argv) >= 4 and sys.argv[1] == 'packet':
        packet(sys.argv[2], sys.argv[3])
    elif len(sys.argv) >= 3 and sys.argv[1] == 'diff':
        diff(sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else None)
    else:
        raise SystemExit(__doc__)
